# Optional: when set, checkout uses Stripe Checkout Sessions.
# Without these keys, student enrollment still works in demo mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Required for paid checkout fulfillment. Point Stripe at:
# POST https://your-domain/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Linked automatically when a Vercel Blob store is connected to the project.
# Persists CEO site settings (phone, email, etc.) across serverless cold starts.
BLOB_READ_WRITE_TOKEN=

# Canonical site URL for metadata / Open Graph.
NEXT_PUBLIC_SITE_URL=https://rodzedu.org

# Analytics (optional). Leave blank to disable.
# Plausible: set your domain (e.g. rodzedu.org)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
