# Copy this file to `.env` and adjust values as needed.
# The app ships with sensible dev defaults, so it also runs with no .env at all.

# Database connection string.
# Dev default (SQLite): file:./prisma/dev.db
# Production (Postgres): postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
#   (also change `datasource.provider` in prisma/schema.prisma to "postgresql")
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session JWTs. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL of the app (used to build Stripe redirect URLs).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe keys (optional). Without these, enrollment uses a built-in demo flow.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
